      }

      main {
        width: 100%;
        margin: 0;
      }

      .recall {
        width: 100%;
        margin: 0;
        padding: 0 0 1.5rem;
        text-align: center;
        background: #000;
      }

      .recall-image-link {
        display: block;
        width: 100%;
      }

      .recall-image {
        display: block;
        width: 100%;
        height: auto;
        max-height: 92vh;
        margin: 0 auto;
        object-fit: contain;
        background: #000;
      }

      .recall-info {
        width: calc(100% - 2rem);
        max-width: 850px;
        margin: 1rem auto 0;
      }

      .recall-info h1 {
        margin: 0 0 0.75rem;
        font-size: 1.6rem;
      }

      .recall-info p {
        line-height: 1.6;
      }

      .recall-button {
        display: inline-block;
        margin-top: 0.75rem;
        padding: 0.9rem 1.6rem;
        border: 1px solid #666;
        border-radius: 8px;
        background: #111;
        color: inherit;
        text-decoration: none;
        font-weight: bold;
      }

      .hero {
        text-align: center;
        padding: 4rem 1rem;
        background: linear-gradient(#1a0033, #000);
        color: #ffd700;
      }

      .intro,
      .corporate,
      .properties,
      .quote,
      .music {
        width: 100%;
        max-width: 1100px;
        margin-left: auto;
        margin-right: auto;
      }

      .intro h1 {
        margin: 0 0 1rem;
        color: #ff0000;
        font-size: 3.5rem;
      }

      .door {
        max-width: 700px;
        margin: 0 auto 1rem;
        font-size: 1.4rem;
      }

      .large-image {
        display: block;
        width: 100%;
        max-width: 700px;
        height: auto;
        margin: 2rem auto;
        border-radius: 16px;
        box-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
      }

      .description {
        max-width: 950px;
        margin: 1.5rem auto;
        line-height: 1.7;
      }

      .properties {
        max-width: 1000px;
        margin-top: 2rem;
        text-align: left;
        line-height: 1.65;
      }

      .properties p {
        margin: 1rem 0;
      }

      .gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        width: 100%;
        max-width: 1100px;
        margin: 3rem auto;
      }

      .gallery-image {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 16px;
        box-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
      }

      .quote {
        max-width: 900px;
        margin-top: 3rem;
        margin-bottom: 3rem;
        line-height: 1.7;
        font-size: 1.1rem;
      }

      .android-box {
        max-width: 700px;
        margin: 3rem auto;
        padding: 2rem;
        text-align: center;
        background: #111;
        border: 2px solid #4B0082;
        border-radius: 14px;
        box-shadow: 0 0 20px rgba(75, 0, 130, 0.4);
      }

      .android-box h2 {
        margin: 0 0 1rem;
        color: #ffd700;
        font-size: 2rem;
      }

      .android-box p {
        color: #ddd;
        line-height: 1.7;
        font-size: 1.05rem;
      }

      .apk-button {
        display: inline-block;
        padding: 14px 28px;
        background: #4B0082;
        color: #fff;
        border-radius: 10px;
        text-decoration: none;
        font-weight: bold;
        font-size: 1.1rem;
      }

      .android-note {
        margin-top: 1.5rem;
        color: #888 !important;
        font-size: 0.9rem !important;
      }

      .music {
        margin-top: 3rem;
      }

      .copyright {
        margin-top: 3rem;
      }

      @media (max-width: 800px) {
        .hero {
          padding-left: 0.75rem;
          padding-right: 0.75rem;
        }

        .intro h1 {
          font-size: 2.25rem;
        }

        .recall-image {
          max-height: none;
        }

        .gallery {
          grid-template-columns: 1fr;
        }

        .properties {
          text-align: center;
        }

        .android-box {
          box-sizing: border-box;
          width: 100%;
          padding: 1.25rem;
        }
      }
    </style>
  </body>
</html>
